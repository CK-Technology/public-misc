# UniFi mass-adoption credentials — copy to `.env` and fill in.
# KEEP `.env` LOCAL: it is gitignored. Never commit it. chmod 600 .env
#
#   cp .env.example .env && chmod 600 .env

# Controller the devices must reach (LAN IP on-site, public IP for L3 adoption).
UNIFI_CONTROLLER=unifi.cktechx.com

# Device inform port (default 8080).
UNIFI_INFORM_PORT=8080

# SSH users to try, in order. Factory devices default to ui / ubnt.
UNIFI_SSH_USERS=ui,ubnt

# SSH password for the devices (factory default, or your managed cred).
# Prefer key auth below when you can.
UNIFI_SSH_PASSWORD=

# Path to an SSH private key (preferred over password).
UNIFI_SSH_KEY=

# Subnets to scan for devices (comma-separated CIDRs). Override with --subnet.
UNIFI_SUBNETS=192.168.1.0/24,10.20.30.0/24

# Optional: integration API key, only for post-adoption verification.
UNIFI_API_KEY=
